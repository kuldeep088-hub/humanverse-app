# Copy to .env.local and fill in your Supabase project values.
# Get these from Supabase Dashboard → Project Settings → API.

# Public Supabase URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — used ONLY by supabase/seed.mjs (server-side).
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL (used for auth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Branding
NEXT_PUBLIC_APP_NAME=Humanverse